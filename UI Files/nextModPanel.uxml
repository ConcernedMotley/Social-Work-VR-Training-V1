<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Files/optionStyleTab.uss?fileID=7433441132597879392&amp;guid=2f567b918cd39394da384bcf09bf8eb1&amp;type=3#optionStyleTab" />
    <ui:VisualElement name="mainBox" class="elementDiv" style="flex-grow: 1; width: 450px; height: auto;">
        <ui:Label text="Continue to next module?" name="messageLabel" class="timeText" />
        <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" mode="Vertical" style="width: 100%; height: 320px;">
            <ui:Label name="debriefTextLabel" enabled="true" class="debriefText" style="height: auto; width: 100%; margin-top: 16px; margin-right: 0; margin-bottom: 16px; margin-left: 0; padding-top: 0; padding-right: 8px; padding-bottom: 0; padding-left: 8px;" />
        </ui:ScrollView>
        <ui:VisualElement name="bottomButton" style="flex-grow: 1; width: 100%; align-self: center; align-items: center; justify-content: flex-start; height: auto; margin-bottom: 32px; margin-top: 32px;">
            <ui:Button text="Continue" name="continueButton" class="button" style="width: 80%; font-size: 32px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
