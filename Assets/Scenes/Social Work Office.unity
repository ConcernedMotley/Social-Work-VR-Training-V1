'
      objectReference: {fileID: 0}
    - target: {fileID: 7329189929071376218, guid: f534253c77d7d414db6e9865d1761ae1, type: 3}
      propertyPath: optionCDebriefMessage
      value: 'The partializing skill is used to help clients break down several aspects
