      objectReference: {fileID: 0}
    - target: {fileID: 7287195866820109073, guid: f534253c77d7d414db6e9865d1761ae1, type: 3}
      propertyPath: optionBDebriefMessage
      value: "Not client-directed, lacks self-determination for the client.\n\nThe
        scenario indicates that we have spent time around the expression of feelings,
        etc. - so paying attention to timing here is key.\n\nAlso, we should be cautious
        about the use of the phrase \u201CYou are brave\u201D, as it can be perceived
        as patronizing if not authentic or if overused. Use with caution!"
      objectReference: {fileID: 0}
    - target: {fileID: 7287195866820109073, guid: f534253c77d7d414db6e9865d1761ae1, type: 3}
      propertyPath: optionCDebriefMessage
      value: 'This is an example of partializing*. It is client centred. Allowing
        the client to choose what they want to focus on. Not overpromising what you
        can achieve in one visit. '
      objectReference: {fileID: 0}
    - target: {fileID: 7329189929071376218, guid: f534253c77d7d414db6e9865d1761ae1, type: 3}
